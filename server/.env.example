# Server environment variables (Hono server)
# These are used when running the server locally with `pnpm dev:server`

# Port for local development
PORT=3001

# GROQ_API_KEY - when running in E2B sandbox, this is passed via environment
# When running locally for testing, set it here
GROQ_API_KEY=your_groq_api_key_here

# Note: E2B_API_KEY is NOT needed here - it's only used by Next.js API routes
# The Hono server receives GROQ_API_KEY from the sandbox creation process
